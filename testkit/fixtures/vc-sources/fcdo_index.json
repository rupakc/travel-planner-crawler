    "content_id": "51d1433e-893f-4424-8408-8427c1b6aba1",
    "details": {
     "step_by_step_nav": {
      "steps": [
       {
        "contents": [
         {
          "contents": [
           {
            "href": "/driving-abroad",
            "text": "Check the rules for using your driving licence abroad"
           }
          ],
          "type": "list"
         },
         {
          "text": "You may need an international driving permit (IDP) to drive outside the UK.",
          "type": "paragraph"
         },
         {
          "contents": [
           {
            "href": "/driving-abroad/international-driving-permit",
            "text": "Check if you need an IDP"
           }
          ],
          "type": "list"
         }
        ],
        "title": "Check where you can use your licence"
       },
       {
        "contents": [
         {
          "contents": [
           {
            "context": "£5.50",
            "href": "https://www.paypoint.com/dvla",
            "text": "Get an IDP in person from certain shops that have PayPoint"
           }
          ],
          "type": "list"
         }
        ],
        "title": "Apply for an international driving permit (IDP)"
       },
       {
        "contents": [
         {
          "contents": [
           {
            "href": "/vehicle-insurance/driving-abroad",
            "text": "Check if your vehicle insurance covers you for the countries you're driving through"
           }
          ],
          "type": "list"
         },
         {
          "text": "Check this with your car hire company if you’re hiring a vehicle.",
          "type": "paragraph"
         }
        ],
        "title": "Get insurance"
       },
       {
        "contents": [
         {
          "contents": [
           {
            "href": "/taking-vehicles-out-of-uk/for-less-than-12-months",
            "text": "Check what documents you need to take a vehicle out of the UK"
           }
          ],
          "type": "list"
         },
         {
          "text": "If you're hiring a car you may need to share your driving licence information with the hire company.",
          "type": "paragraph"
         },
         {
          "contents": [
           {
            "href": "/view-driving-licence",
            "text": "Get a 'check code' to share your driving licence information"
           }
          ],
          "type": "list"
         },
         {
          "text": "If you got your licence in Northern Ireland, you’ll need to show the rental company your paper counterpart instead.",
          "type": "paragraph"
         }
        ],
        "title": "Prepare the documents you need to take with you"
       },
       {
        "contents": [
         {
          "text": "The rules for driving may be different in the country you're going to. For example, drink-driving rules might be different or you might need to carry extra equipment in your car.",
          "type": "paragraph"
         },
         {
          "contents": [
           {
            "href": "/displaying-number-plates/flags-identifiers-and-stickers",
            "text": "Check if you need to display a country sticker on your vehicle"
           },
           {
            "href": "/guidance/driving-in-the-eu",
            "text": "Check what you need to do if you’re driving in the EU, Switzerland, Iceland, Liechtenstein or Norway"
           },
           {
            "href": "/foreign-travel-advice",
            "text": "Check the travel advice for all countries"
           }
          ],
          "type": "list"
         },
         {
          "text": "When you have your documents, insurance and any extra equipment you need you can drive abroad.",
          "type": "paragraph"
         }
        ],
        "title": "Check the rules for the country you're travelling to"
       }
      ],
      "title": "Drive abroad: step by step"
     }
