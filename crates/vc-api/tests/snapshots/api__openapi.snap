---
source: crates/vc-api/tests/api.rs
expression: json
---
{
  "components": {
    "schemas": {
      "ChangeDto": {
        "description": "One change.",
        "properties": {
          "at": {
            "description": "When.",
            "format": "date-time",
            "type": "string"
          },
          "cursor": {
            "description": "Opaque position (`<xid>-<seq>`).",
            "type": "string"
          },
          "kind": {
            "description": "Kind, when applicable.",
            "type": [
              "string",
              "null"
            ]
          },
          "op": {
            "$ref": "#/components/schemas/ChangeOpDto",
            "description": "Operation."
          },
          "owner_id": {
            "description": "Owner id.",
            "type": "string"
          },
          "owner_type": {
            "$ref": "#/components/schemas/OwnerTypeDto",
            "description": "Owner type."
          }
        },
        "required": [
          "cursor",
          "owner_type",
          "owner_id",
          "op",
          "at"
        ],
        "type": "object"
      },
      "ChangeOpDto": {
        "description": "`changes.op`.",
        "enum": [
          "upsert",
          "tombstone",
          "redirect"
        ],
        "type": "string"
      },
      "ChangesDto": {
        "description": "A page of the change feed.",
        "properties": {
          "changes": {
            "description": "Changes in cursor order.",
            "items": {
              "$ref": "#/components/schemas/ChangeDto"
            },
            "type": "array"
          },
          "next": {
            "description": "Pass as `since` next time (the last change, or the input cursor when empty).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "changes"
        ],
        "type": "object"
      },
      "ClaimDto": {
        "description": "One per-attribute claim of an entity.",
        "properties": {
          "attribute": {
            "description": "Attribute.",
            "type": "string"
          },
          "confidence": {
            "description": "Confidence in `[0, 1]`.",
            "format": "float",
            "type": "number"
          },
          "record_id": {
            "description": "Contributing record.",
            "format": "int64",
            "type": "integer"
          },
          "value": {
            "description": "Value.",
            "type": "object"
          },
          "version": {
            "description": "Record version.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "attribute",
          "value",
          "record_id",
          "version",
          "confidence"
        ],
        "type": "object"
      },
      "EntityDto": {
        "description": "An entity with its claims.",
        "properties": {
          "claims": {
            "description": "Per-attribute provenance.",
            "items": {
              "$ref": "#/components/schemas/ClaimDto"
            },
            "type": "array"
          },
          "item": {
            "$ref": "#/components/schemas/ItemDto",
            "description": "The entity."
          }
        },
        "required": [
          "item",
          "claims"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The body of every error response.",
        "properties": {
          "error": {
            "description": "Stable machine-readable code: `unauthorized`, `bad_request`, `not_found`,\n`rate_limited`, `unavailable`, `internal`.",
            "type": "string"
          },
          "message": {
            "description": "Human-readable detail (never contains page content or tokens).",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "ExtractionMethodDto": {
        "description": "How a record was extracted.",
        "enum": [
          "structured",
          "adapter",
          "llm"
        ],
        "type": "string"
      },
      "ExtractorDto": {
        "description": "Who/what extracted a record.",
        "properties": {
          "method": {
            "$ref": "#/components/schemas/ExtractionMethodDto",
            "description": "Method."
          },
          "model": {
            "description": "Model id, for LLM extraction.",
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_hash": {
            "description": "blake3 hex of the prompt, for LLM extraction.",
            "type": [
              "string",
              "null"
            ]
          },
          "run_id": {
            "description": "Extraction run id (ULID), if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "Extractor version.",
            "type": "string"
          }
        },
        "required": [
          "version",
          "method"
        ],
        "type": "object"
      },
      "FactDto": {
        "description": "One place fact.",
        "properties": {
          "ai_bot_blocked": {
            "description": "The source's robots.txt blocks AI bots.",
            "type": "boolean"
          },
          "as_of": {
            "description": "Crawl, edit or edition date (YYYY-MM-DD).",
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "description": "`structured`, `extracted` or `corroborated`.",
            "type": "string"
          },
          "date_ref": {
            "description": "Year or date the fact refers to (`1244`, `1806-10-27`, `-0500`).",
            "type": [
              "string",
              "null"
            ]
          },
          "fact_type": {
            "description": "`historical`, `fun`, `popular`, `unbelievable` or `little_known`.",
            "type": "string"
          },
          "id": {
            "description": "Record id.",
            "type": "string"
          },
          "lang": {
            "description": "Language of `text` (BCP 47).",
            "type": [
              "string",
              "null"
            ]
          },
          "licence": {
            "$ref": "#/components/schemas/LicenceDto",
            "description": "Licence (share-alike: never merge with other text; keep the attribution)."
          },
          "llm_ok": {
            "description": "Whether `text` may be given to a model: always false for share-alike text, hooks and\nAI-reserved sources.",
            "type": "boolean"
          },
          "place": {
            "$ref": "#/components/schemas/FactPlaceDto",
            "description": "The place."
          },
          "quantity": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FactQuantityDto",
                "description": "The figure behind it (structured sources only)."
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/FactSourceDto",
            "description": "Source."
          },
          "text": {
            "description": "One sentence in our own words (≤ 280 characters), or a short share-alike hook when\n`text_origin` is `source_hook`.",
            "type": "string"
          },
          "text_en": {
            "description": "Machine translation to English, when one was made at ingest.",
            "type": [
              "string",
              "null"
            ]
          },
          "text_origin": {
            "description": "`templated`, `rewritten` or `source_hook`.",
            "type": "string"
          },
          "updated_at": {
            "description": "Last update of the record.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "place",
          "fact_type",
          "text",
          "text_origin",
          "llm_ok",
          "source",
          "licence",
          "confidence",
          "ai_bot_blocked",
          "updated_at"
        ],
        "type": "object"
      },
      "FactPage": {
        "description": "A page of facts.",
        "properties": {
          "items": {
            "description": "Facts, by record id.",
            "items": {
              "$ref": "#/components/schemas/FactDto"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass back as `cursor` for the next page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "FactPlaceDto": {
        "description": "The place of a fact (`/v1/facts`): the resolved place (a hook takes the Wikidata place it\nwas resolved to).",
        "properties": {
          "admin_level": {
            "description": "`country`, `admin1`, `admin2`, `locality`, `village` or `feature`, when known.",
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "description": "ISO 3166-1 alpha-2 country.",
            "type": [
              "string",
              "null"
            ]
          },
          "geonames_id": {
            "description": "GeoNames id (the primary join key).",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "Name in the source.",
            "type": [
              "string",
              "null"
            ]
          },
          "name_lang": {
            "description": "Language of `name`.",
            "type": [
              "string",
              "null"
            ]
          },
          "wikidata_qid": {
            "description": "Wikidata QID.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "FactQuantityDto": {
        "description": "A figure behind a record or statistic.",
        "properties": {
          "rank_scope": {
            "description": "What a record is a record of (`highest point of Germany`).",
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "description": "Unit (`m`, `km2`, `people`, `sites`, …).",
            "type": "string"
          },
          "value": {
            "description": "The figure.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "type": "object"
      },
      "FactSourceDto": {
        "description": "Where a fact comes from.",
        "properties": {
          "name": {
            "description": "Name of the work (else the source's registry name).",
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "description": "Publisher.",
            "type": [
              "string",
              "null"
            ]
          },
          "source_class": {
            "description": "`official`, `reference`, `editorial`, `community` or `commercial_api`.",
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "description": "Source id (`sources/*.yaml`).",
            "type": "string"
          },
          "sourced": {
            "description": "Whether the source cites its own sources for it: `yes`, `partial` or `no`.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "Deep link to the fact at the source.",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "url"
        ],
        "type": "object"
      },
      "IndexUseDto": {
        "description": "What may be indexed and served.",
        "enum": [
          "title_and_link",
          "full"
        ],
        "type": "string"
      },
      "ItemDto": {
        "description": "One served item (entity or record).",
        "properties": {
          "conflict": {
            "description": "A cross-source conflict on a high-stakes field: show with care.",
            "type": "boolean"
          },
          "data": {
            "description": "Facts, per the kind's JSON schema.",
            "type": "object"
          },
          "excerpt": {
            "description": "≤ 300-character excerpt (the only text served for `facts_only`).",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Entity id (ULID) or record id (decimal).",
            "type": "string"
          },
          "kind": {
            "description": "Kind (e.g. `attraction`, `event`, `article`).",
            "type": "string"
          },
          "licence": {
            "$ref": "#/components/schemas/LicenceDto",
            "description": "Licence."
          },
          "place_ids": {
            "description": "GeoNames ids.",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "provenance": {
            "description": "One entry per contributing record.",
            "items": {
              "$ref": "#/components/schemas/ProvenanceDto"
            },
            "type": "array"
          },
          "schema": {
            "description": "`kind@version` of `data`.",
            "type": "string"
          },
          "score": {
            "description": "Ranking score (search only).",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "title": {
            "description": "Title / headline.",
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "description": "Last update.",
            "format": "date-time",
            "type": "string"
          },
          "use_policy": {
            "$ref": "#/components/schemas/UsePolicyDto",
            "description": "Effective use policy."
          }
        },
        "required": [
          "id",
          "kind",
          "schema",
          "data",
          "place_ids",
          "licence",
          "provenance",
          "conflict",
          "use_policy",
          "updated_at"
        ],
        "type": "object"
      },
      "ItemPage": {
        "description": "A page of items.",
        "properties": {
          "items": {
            "description": "Items.",
            "items": {
              "$ref": "#/components/schemas/ItemDto"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass as `cursor` for the next page; absent on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "LicenceClassDto": {
        "description": "Licence class of served data (`restricted` data is never ingested or served).",
        "enum": [
          "open",
          "share_alike",
          "facts_only",
          "api_terms"
        ],
        "type": "string"
      },
      "LicenceDto": {
        "description": "`licence {class, spdx, attribution, url}`, on every item.",
        "properties": {
          "attribution": {
            "description": "Attribution to display.",
            "type": "string"
          },
          "class": {
            "$ref": "#/components/schemas/LicenceClassDto",
            "description": "Licence class."
          },
          "spdx": {
            "description": "SPDX id, when there is one.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "Licence or terms URL.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "class",
          "attribution"
        ],
        "type": "object"
      },
      "ObservationDto": {
        "description": "One observation.",
        "properties": {
          "licence": {
            "$ref": "#/components/schemas/LicenceDto",
            "description": "Licence."
          },
          "observed_at": {
            "description": "Time.",
            "format": "date-time",
            "type": "string"
          },
          "series_key": {
            "description": "Series (e.g. `fx:USD:EUR`).",
            "type": "string"
          },
          "source_id": {
            "description": "Source id.",
            "type": "string"
          },
          "value": {
            "description": "Value.",
            "type": "object"
          }
        },
        "required": [
          "series_key",
          "observed_at",
          "value",
          "source_id",
          "licence"
        ],
        "type": "object"
      },
      "ObservationList": {
        "description": "Observations of a series.",
        "properties": {
          "items": {
            "description": "Points, oldest first.",
            "items": {
              "$ref": "#/components/schemas/ObservationDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "OwnerTypeDto": {
        "description": "`changes.owner_type`.",
        "enum": [
          "record",
          "entity",
          "observation",
          "source"
        ],
        "type": "string"
      },
      "PlaceDto": {
        "description": "A candidate place.",
        "properties": {
          "admin1": {
            "description": "First-level admin region.",
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "description": "ISO 3166-1 alpha-2 country.",
            "type": "string"
          },
          "geoname_id": {
            "description": "GeoNames id.",
            "format": "int64",
            "type": "integer"
          },
          "lat": {
            "description": "Latitude.",
            "format": "double",
            "type": "number"
          },
          "lon": {
            "description": "Longitude.",
            "format": "double",
            "type": "number"
          },
          "name": {
            "description": "Canonical name.",
            "type": "string"
          },
          "score": {
            "description": "Confidence in `[0, 1]`.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "geoname_id",
          "name",
          "country",
          "lat",
          "lon",
          "score"
        ],
        "type": "object"
      },
      "PlaceList": {
        "description": "Place candidates, best first.",
        "properties": {
          "items": {
            "description": "Candidates (empty when unresolved).",
            "items": {
              "$ref": "#/components/schemas/PlaceDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ProvenanceDto": {
        "description": "Where a served item came from.",
        "properties": {
          "captured_at": {
            "description": "Capture time.",
            "format": "date-time",
            "type": "string"
          },
          "extractor": {
            "$ref": "#/components/schemas/ExtractorDto",
            "description": "Extractor."
          },
          "source_id": {
            "description": "Source id (`/v1/sources`).",
            "type": "string"
          },
          "url": {
            "description": "Page URL (the link to show).",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "url",
          "captured_at",
          "extractor"
        ],
        "type": "object"
      },
      "RecordVersionDto": {
        "description": "One version of a record.",
        "properties": {
          "captured_at": {
            "description": "Capture time.",
            "format": "date-time",
            "type": "string"
          },
          "data": {
            "description": "Data.",
            "type": "object"
          },
          "data_hash": {
            "description": "blake3 hex of the canonical JSON.",
            "type": "string"
          },
          "extractor": {
            "$ref": "#/components/schemas/ExtractorDto",
            "description": "Extractor."
          },
          "licence_class": {
            "$ref": "#/components/schemas/LicenceClassDto",
            "description": "Licence class."
          },
          "record_id": {
            "description": "Record id.",
            "format": "int64",
            "type": "integer"
          },
          "schema": {
            "description": "`kind@version`.",
            "type": "string"
          },
          "superseded_at": {
            "description": "Superseded at (absent = current).",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "use_policy": {
            "$ref": "#/components/schemas/UsePolicyDto",
            "description": "Effective use policy."
          },
          "valid_from": {
            "description": "Valid from.",
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "description": "Version (1-based).",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "record_id",
          "version",
          "schema",
          "data",
          "data_hash",
          "captured_at",
          "extractor",
          "licence_class",
          "use_policy",
          "valid_from"
        ],
        "type": "object"
      },
      "RedirectDto": {
        "description": "Body of a `301` for a merged entity (`Location` carries the same path).",
        "properties": {
          "location": {
            "description": "Its path.",
            "type": "string"
          },
          "redirect_to": {
            "description": "The entity it was merged into.",
            "type": "string"
          }
        },
        "required": [
          "redirect_to",
          "location"
        ],
        "type": "object"
      },
      "ServeUseDto": {
        "description": "What may be shown to Voyager's agents.",
        "enum": [
          "link_only",
          "facts_only",
          "full"
        ],
        "type": "string"
      },
      "SourceDto": {
        "description": "One configured source.",
        "properties": {
          "category": {
            "description": "Category.",
            "type": "string"
          },
          "enabled": {
            "description": "Whether it is crawled.",
            "type": "boolean"
          },
          "licence": {
            "$ref": "#/components/schemas/LicenceDto",
            "description": "Licence."
          },
          "method": {
            "description": "`html`, `rss`, `sitemap`, `api` or `dump`.",
            "type": "string"
          },
          "name": {
            "description": "Name.",
            "type": "string"
          },
          "source_class": {
            "description": "`official`, `reference`, `editorial`, `community` or `commercial_api`.",
            "type": "string"
          },
          "source_id": {
            "description": "Source id.",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "name",
          "category",
          "source_class",
          "licence",
          "method",
          "enabled"
        ],
        "type": "object"
      },
      "SourceList": {
        "description": "The sources.",
        "properties": {
          "items": {
            "description": "Sources, by id.",
            "items": {
              "$ref": "#/components/schemas/SourceDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "StatsDto": {
        "description": "Index statistics.",
        "properties": {
          "changes_seq_max": {
            "description": "Highest change-feed sequence (absent when empty).",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "entities_active": {
            "description": "Active entities.",
            "format": "int64",
            "type": "integer"
          },
          "generated_at": {
            "description": "When these numbers were computed (cached up to 60 s).",
            "format": "date-time",
            "type": "string"
          },
          "records_active": {
            "description": "Active records.",
            "format": "int64",
            "type": "integer"
          },
          "sources_enabled": {
            "description": "Enabled sources.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "sources_enabled",
          "records_active",
          "entities_active",
          "generated_at"
        ],
        "type": "object"
      },
      "StatusDto": {
        "description": "Probe answer.",
        "properties": {
          "status": {
            "description": "`ok` or `ready`.",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "UsePolicyDto": {
        "description": "The effective use policy of an item (the API has already applied it).",
        "properties": {
          "index": {
            "$ref": "#/components/schemas/IndexUseDto",
            "description": "Index use."
          },
          "serve": {
            "$ref": "#/components/schemas/ServeUseDto",
            "description": "Serve use."
          }
        },
        "required": [
          "index",
          "serve"
        ],
        "type": "object"
      },
      "VersionPage": {
        "description": "A page of record versions, newest first.",
        "properties": {
          "items": {
            "description": "Versions.",
            "items": {
              "$ref": "#/components/schemas/RecordVersionDto"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Next page cursor.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Private, internal-only read API of the Voyager crawler. Frozen /v1 contract: additive changes only (Crawler-API.md).",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Voyager Crawler read API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          }
        },
        "summary": "Liveness; 503 while the hosting process reports itself unhealthy (`ApiState::with_health`).",
        "tags": [
          "probe"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "summary": "Readiness (the database answers).",
        "tags": [
          "probe"
        ]
      }
    },
    "/v1/articles": {
      "get": {
        "operationId": "articles",
        "parameters": [
          {
            "description": "Free text.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Exact GeoNames id.",
            "in": "query",
            "name": "place",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Comma-separated kinds (ignored by `/v1/articles`, which is always `article`).",
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Radius search: latitude (with `lon` and `radius_km`).",
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Radius search: longitude.",
            "in": "query",
            "name": "lon",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Radius search: radius in km.",
            "in": "query",
            "name": "radius_km",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Only items updated since (RFC 3339).",
            "in": "query",
            "name": "updated_since",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Page size (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Articles (headline + excerpt + facts + link).",
        "tags": [
          "read"
        ]
      }
    },
    "/v1/carbon/factors": {
      "get": {
        "operationId": "carbon_factors",
        "parameters": [
          {
            "description": "`category` (`flights`, `rail`, `bus`, `coach`, `ferry`, `car`, `taxi`, `motorbike`,\n`accommodation`, `food`, `activity`, `electricity`, `fuel`, `other`).",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ISO 3166-1 alpha-2 `country_code` (e.g. `GB`).",
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`region_code` (eGRID subregion `CAMX`, US state `CA`).",
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Factor-set `year`.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "`gas_basis` (`co2`, `co2e`, `co2e_with_rf`, `co2e_without_rf`).",
            "in": "query",
            "name": "gas_basis",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The `activity` slug contains this snake_case text (e.g. `long_haul`).",
            "in": "query",
            "name": "activity",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Source id (e.g. `od-desnz-ghg-factors`).",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Published emission factors (kind `emission_factor`), newest factor-set year first:\nfiltered by category, country, region, year, gas basis, activity and source.",
        "tags": [
          "read"
        ]
      }
    },
    "/v1/carbon/grid": {
      "get": {
        "operationId": "carbon_grid",
        "parameters": [
          {
            "description": "ISO 3166-1 alpha-2 country (required).",
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`annual` or `monthly` (default both).",
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`lifecycle` or `direct` (default both).",
            "in": "query",
            "name": "basis",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "From (inclusive, RFC 3339; default 2000-01-01).",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "To (exclusive, RFC 3339; default now).",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Max points (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationList"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Grid carbon intensity of one country (kind `grid_carbon_intensity`, every series\n`grid_ci:<country>:<period>:<basis>` and source), newest first.",
        "tags": [
          "read"
        ]
      }
    },
    "/v1/carbon/occupancy": {
      "get": {
        "operationId": "carbon_occupancy",
        "parameters": [
          {
            "description": "`mode` (`car`, `taxi`, `bus`, `coach`, `bus_coach`, `rail`, `light_rail`, `ferry`,\n`motorcycle`, `van`, `all_vehicles`, `other`).",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ISO 3166-1 alpha-2 `country_code` (e.g. `GB`).",
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The `year` the figure is for.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "`trip_purpose` (`all`, `work`, `commuting`, `leisure`, `other`).",
            "in": "query",
            "name": "trip_purpose",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`basis` (`per_vehicle_km`, `per_trip`).",
            "in": "query",
            "name": "basis",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Source id (e.g. `od-dft-tag-databook`).",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Published average vehicle occupancies (kind `occupancy`, persons per vehicle), newest year\nfirst: filtered by mode, country, year, trip purpose, basis and source.",
        "tags": [
          "read"
        ]
      }
    },
    "/v1/changes": {
      "get": {
        "operationId": "changes",
        "parameters": [
          {
            "description": "`next` of the previous page (absent = from the start).",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated kinds (absent = all).",
            "in": "query",
            "name": "kinds",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesDto"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The change feed. Only committed transactions older than every open one are served, so a\nclient that pages with `since = next` never skips a change.",
        "tags": [
          "sync"
        ]
      }
    },
    "/v1/entities": {
      "get": {
        "operationId": "entities",
        "parameters": [
          {
            "description": "Free text.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Exact GeoNames id.",
            "in": "query",
            "name": "place",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Comma-separated kinds (ignored by `/v1/articles`, which is always `article`).",
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Radius search: latitude (with `lon` and `radius_km`).",
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Radius search: longitude.",
            "in": "query",
            "name": "lon",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Radius search: radius in km.",
            "in": "query",
            "name": "radius_km",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Only items updated since (RFC 3339).",
            "in": "query",
            "name": "updated_since",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Page size (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Entities by place, kind and text.",
        "tags": [
          "read"
        ]
      }
    },
    "/v1/entities/{id}": {
      "get": {
        "operationId": "entity",
        "parameters": [
          {
            "description": "Entity id (ULID)",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityDto"
                }
              }
            }
          },
          "301": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedirectDto"
                }
              }
            },
            "description": "Merged; `Location` names the successor"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "One entity with its claims; a merged entity answers `301` to its successor.",
        "tags": [
          "read"
        ]
      }
    },
    "/v1/facts": {
      "get": {
        "operationId": "facts",
        "parameters": [
          {
            "description": "GeoNames id of the place (e.g. `2950159`).",
            "in": "query",
            "name": "geonames_id",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Wikidata QID of the place (e.g. `Q64`).",
            "in": "query",
            "name": "wikidata_qid",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ISO 3166-1 alpha-2 country of the place (e.g. `DE`).",
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`historical`, `fun`, `popular`, `unbelievable` or `little_known`.",
            "in": "query",
            "name": "fact_type",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactPage"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Place facts (kind `place_fact`): short facts about one place (historical, fun, popular,\nrecord-breaking, little known), by record id: filtered by GeoNames id, Wikidata QID,\ncountry and fact type. Wikipedia hooks appear only once resolved to a Wikidata place.",
        "tags": [
          "read"
        ]
      }
    },
    "/v1/observations": {
      "get": {
        "operationId": "observations",
        "parameters": [
          {
            "description": "Series key (e.g. `fx:USD:EUR`).",
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "From (inclusive, RFC 3339; default `to` − 30 days).",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "To (exclusive, RFC 3339; default now).",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Max points (default 20, max `max_page`).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationList"
                }
              }
