[Unit]
Description=Voyager Crawler wal-g full base backup to gs://voyager-crawler-ops/walg (weekly; 2 kept by the bucket lifecycle)
# A failure is recorded for the crawler_host_units_failed alert
OnFailure=voyager-crawler-failed@%n.service
Requires=docker.service
After=docker.service voyager-crawler.service
RequiresMountsFor=/var/lib/voyager-crawler
ConditionPathExists=/var/lib/voyager-crawler/deploy/image.env

[Service]
Type=oneshot
# Always a full backup: the bucket lifecycle deletes walg/ objects 14 days old, so
# a delta could outlive the base it builds on. Weekly full + 14 days = the two
# newest base backups and the WAL since the older one (nothing older is needed).
ExecStart=/opt/voyager-crawler/host/vc-compose.sh exec -T -u postgres postgres wal-g backup-push --full /var/lib/postgresql/data/pgdata
# Records success (and the last_ok_at the backup/drill age alerts read); never fails the unit
ExecStartPost=-/opt/voyager-crawler/host/unit-status.sh ok %n
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
