[Unit]
Description=Voyager Crawler wal-g base backup (delta, a full one every 7th) to gs://voyager-crawler-ops/walg
Requires=docker.service
After=docker.service voyager-crawler.service
RequiresMountsFor=/var/lib/voyager-crawler
ConditionPathExists=/var/lib/voyager-crawler/deploy/image.env

[Service]
Type=oneshot
ExecStart=/opt/voyager-crawler/host/vc-compose.sh exec -T -u postgres postgres wal-g backup-push /var/lib/postgresql/data/pgdata
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
