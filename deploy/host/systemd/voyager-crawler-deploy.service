[Unit]
Description=Voyager Crawler signed-digest deployer (prod tag → cosign verify → pull → migrate → roll → health → rollback)
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target voyager-crawler.service
RequiresMountsFor=/var/lib/voyager-crawler

[Service]
Type=oneshot
ExecStart=/opt/voyager-crawler/host/deploy.sh
# migrate + six roles × the health timeout, with room to roll back
TimeoutStartSec=60min
