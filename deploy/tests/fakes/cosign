#!/usr/bin/env bash
# Fake cosign: records the call; `verify` succeeds only for a reference
# whose digest is listed in $FAKE_SIGNED and with the pinned identity/issuer.
echo "cosign $*" >>"$CALLS"
[[ "${1:-}" == verify ]] || exit 0
ref="${*: -1}"
want_id="https://github.com/rupakc/travel-planner-crawler/.github/workflows/deploy.yml@refs/heads/main"
[[ "$*" == *"--certificate-identity $want_id "* ]] || exit 1
[[ "$*" == *"--certificate-oidc-issuer https://token.actions.githubusercontent.com "* ]] || exit 1
for d in ${FAKE_SIGNED:-}; do
  [[ "$ref" == *"@$d" ]] && exit 0
done
exit 1
