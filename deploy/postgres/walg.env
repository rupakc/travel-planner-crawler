# wal-g settings for the postgres container (compose env_file). No secrets:
# wal-g authenticates to GCS as the VM's service account (crawler-runtime)
# through the metadata server, reached over the `pgbackup` network.
# crawler-runtime has objectCreator + objectViewer on the ops bucket: it can
# write and read backups but never delete them; the bucket lifecycle expires
# them after 14 days.
WALG_GS_PREFIX=gs://voyager-crawler-ops/walg
# Never overwrite an archived WAL segment. crawler-runtime has no delete or
# overwrite right on -ops, so without this a retried archive_command (the
# segment was uploaded, Postgres did not see the success) fails forever and
# WAL piles up on the data disk. With it, wal-g compares the existing object:
# an identical re-push exits 0, a different one fails loudly.
WALG_PREVENT_WAL_OVERWRITE=true
# lz4, not zstd: wal-g v3.0.9 wal-fetch probes "<name>.lz4" first and treats GCS's
# 404 as fatal instead of trying the next extension, so .zst segments could never be
# restored (found by the first real restore drill, 2026-11-17).
WALG_COMPRESSION_METHOD=lz4
WALG_DELTA_MAX_STEPS=6
WALG_UPLOAD_CONCURRENCY=4
WALG_DOWNLOAD_CONCURRENCY=4
WALG_UPLOAD_DISK_CONCURRENCY=2
WALG_TAR_SIZE_THRESHOLD=1073741823
PGHOST=/var/run/postgresql
PGUSER=vcrawl
PGDATABASE=vcrawl
