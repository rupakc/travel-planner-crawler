{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rupakc/travel-planner-crawler/schemas/hotel.v1.json",
  "title": "Hotel",
  "description": "One record: one place to stay, descriptive facts only (no live prices or availability). Voyager use: hotels (name, star_rating, location, amenities, budget tier); prices stay live in Voyager.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 160,
      "description": "Property name as written."
    },
    "property_type": {
      "type": "string",
      "enum": [
        "hotel",
        "hostel",
        "guesthouse",
        "ryokan",
        "bnb",
        "apartment",
        "resort",
        "capsule",
        "campsite",
        "other"
      ],
      "description": "Type."
    },
    "star_rating": {
      "type": "number",
      "description": "Official star rating, if stated.",
      "minimum": 0,
      "maximum": 5
    },
    "tier": {
      "type": "string",
      "enum": [
        "luxury",
        "premium",
        "mid_range",
        "budget"
      ],
      "description": "Price tier only if the page itself places it (e.g. \"budget hostel\", \"5-star luxury\")."
    },
    "description": {
      "type": "string",
      "maxLength": 600,
      "description": "Two or three sentences."
    },
    "address": {
      "type": "string",
      "maxLength": 240,
      "description": "Street address as written."
    },
    "neighbourhood": {
      "type": "string",
      "maxLength": 120,
      "description": "Neighbourhood or district."
    },
    "city": {
      "type": "string",
      "maxLength": 120,
      "description": "City in English. Always paired with `country`."
    },
    "country": {
      "type": "string",
      "maxLength": 80,
      "description": "Country in English (e.g. \"Japan\"). Required whenever `city` is set."
    },
    "country_code": {
      "type": "string",
      "maxLength": 2,
      "description": "ISO 3166-1 alpha-2 country code of `country`.",
      "pattern": "^[A-Z]{2}$"
    },
    "lat": {
      "type": "number",
      "description": "Latitude in decimal degrees, only if the page states coordinates.",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "description": "Longitude in decimal degrees, only if the page states coordinates.",
      "minimum": -180,
      "maximum": 180
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60,
        "description": "Amenity."
      },
      "maxItems": 12,
      "description": "Amenities (e.g. \"spa\", \"free wifi\", \"airport shuttle\")."
    },
    "check_in_time": {
      "type": "string",
      "maxLength": 5,
      "description": "Earliest check-in (24 h HH:MM).",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "check_out_time": {
      "type": "string",
      "maxLength": 5,
      "description": "Latest check-out (24 h HH:MM).",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "phone": {
      "type": "string",
      "maxLength": 32,
      "description": "Front desk phone. As written on the page (digits, spaces, +, -, (, ), .).",
      "pattern": "^\\+?[0-9][0-9 ().\\-/]{1,30}$"
    },
    "website_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "Official property website.",
      "pattern": "^https?://[^\\s]+$"
    },
    "accessibility_features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wheelchair_accessible",
          "step_free_access",
          "accessible_toilet",
          "elevator",
          "ramp",
          "audio_guide",
          "sign_language",
          "braille",
          "hearing_loop",
          "service_animals_allowed",
          "seating_available",
          "stroller_friendly"
        ],
        "description": "An accessibility feature."
      },
      "maxItems": 8,
      "description": "Accessibility features the page states explicitly."
    },
    "family_friendly": {
      "type": "boolean",
      "description": "Stated as family friendly."
    },
    "pets_allowed": {
      "type": "boolean",
      "description": "Stated pet policy."
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "description": "Average rating as shown.",
          "minimum": 0,
          "maximum": 100
        },
        "scale": {
          "type": "number",
          "description": "Top of the rating scale (5, 10 or 100).",
          "minimum": 1,
          "maximum": 100
        },
        "count": {
          "type": "integer",
          "description": "Number of reviews behind the rating.",
          "minimum": 0
        }
      },
      "description": "A rating shown on the page (never computed)."
    },
    "source_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "The page's own link for this item (official site, booking or detail page), copied verbatim from the page.",
      "pattern": "^https?://[^\\s]+$"
    },
    "as_of": {
      "type": "string",
      "maxLength": 10,
      "description": "The \"last updated\", \"valid from\" or publication date the page itself states for this information (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300,
        "description": "A verbatim quote from the page."
      },
      "maxItems": 3,
      "description": "Up to 3 short verbatim quotes from the page that support the most important facts."
    }
  },
  "required": [
    "name",
    "city",
    "country"
  ]
}
