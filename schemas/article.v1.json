{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rupakc/travel-planner-crawler/schemas/article.v1.json",
  "title": "Article",
  "description": "One record: the facts in one editorial article (guide, news or blog post) about travel. Voyager use: grounding for chat answers and activities/places discovery.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "headline": {
      "type": "string",
      "maxLength": 200,
      "description": "The headline as written."
    },
    "summary": {
      "type": "string",
      "maxLength": 600,
      "description": "A neutral factual summary in your own words (never copied paragraphs)."
    },
    "author": {
      "type": "string",
      "maxLength": 120,
      "description": "Byline."
    },
    "published_date": {
      "type": "string",
      "maxLength": 10,
      "description": "Publication date (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_date": {
      "type": "string",
      "maxLength": 10,
      "description": "Last updated date (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "article_type": {
      "type": "string",
      "enum": [
        "guide",
        "news",
        "itinerary",
        "review",
        "listicle",
        "opinion",
        "other"
      ],
      "description": "Type."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "food",
          "culture",
          "history",
          "nature",
          "nightlife",
          "shopping",
          "budget",
          "luxury",
          "family",
          "safety",
          "transport",
          "accommodation",
          "events",
          "visa",
          "health",
          "other"
        ],
        "description": "Topic."
      },
      "maxItems": 5,
      "description": "Topics."
    },
    "city": {
      "type": "string",
      "maxLength": 120,
      "description": "City in English. Always paired with `country`."
    },
    "country": {
      "type": "string",
      "maxLength": 80,
      "description": "Country in English (e.g. \"Japan\"). Required whenever `city` is set."
    },
    "country_code": {
      "type": "string",
      "maxLength": 2,
      "description": "ISO 3166-1 alpha-2 country code of `country`.",
      "pattern": "^[A-Z]{2}$"
    },
    "places_mentioned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "description": "Place or sight name."
          },
          "city": {
            "type": "string",
            "maxLength": 120,
            "description": "City in English."
          },
          "country": {
            "type": "string",
            "maxLength": 80,
            "description": "Country in English."
          }
        },
        "required": [
          "name"
        ]
      },
      "maxItems": 12,
      "description": "Places, sights and venues the article recommends, each paired with city and country."
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "description": "One short factual statement."
      },
      "maxItems": 8,
      "description": "Concrete facts a traveller can use (prices, hours, closures, tips), in your own words."
    },
    "source_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "The page's own link for this item (official site, booking or detail page), copied verbatim from the page.",
      "pattern": "^https?://[^\\s]+$"
    },
    "as_of": {
      "type": "string",
      "maxLength": 10,
      "description": "The \"last updated\", \"valid from\" or publication date the page itself states for this information (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300,
        "description": "A verbatim quote from the page."
      },
      "maxItems": 3,
      "description": "Up to 3 short verbatim quotes from the page that support the most important facts."
    }
  },
  "required": [
    "headline"
  ]
}
