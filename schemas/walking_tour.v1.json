{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rupakc/travel-planner-crawler/schemas/walking_tour.v1.json",
  "title": "Walking tour",
  "description": "One record: one walking tour listing (free/tip-based or paid). Voyager use: walking_tours candidates (id, name, provider, url, description, rating, review_count, duration, city).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 160,
      "description": "Tour name as written."
    },
    "provider": {
      "type": "string",
      "maxLength": 120,
      "description": "Platform or company (e.g. \"GuruWalk\", \"SANDEMANs\")."
    },
    "description": {
      "type": "string",
      "maxLength": 600,
      "description": "What the route covers."
    },
    "city": {
      "type": "string",
      "maxLength": 120,
      "description": "City in English. Always paired with `country`."
    },
    "country": {
      "type": "string",
      "maxLength": 80,
      "description": "Country in English (e.g. \"Japan\"). Required whenever `city` is set."
    },
    "country_code": {
      "type": "string",
      "maxLength": 2,
      "description": "ISO 3166-1 alpha-2 country code of `country`.",
      "pattern": "^[A-Z]{2}$"
    },
    "meeting_point": {
      "type": "string",
      "maxLength": 240,
      "description": "Meeting point as written."
    },
    "duration_hours": {
      "type": "number",
      "description": "Duration in hours.",
      "minimum": 0,
      "maximum": 12
    },
    "price_model": {
      "type": "string",
      "enum": [
        "free_tip_based",
        "pay_what_you_want",
        "paid"
      ],
      "description": "How it is paid for."
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 80,
          "description": "The price exactly as written on the page, e.g. \"€45.00\", \"from ¥1,500\", \"Free\"."
        },
        "amount": {
          "type": "number",
          "description": "The number in `text`, without currency symbols or thousands separators.",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "description": "ISO 4217 code of the currency in `text`; never converted.",
          "pattern": "^[A-Z]{3}$"
        },
        "unit": {
          "type": "string",
          "maxLength": 40,
          "description": "What the price is for, e.g. \"per person\", \"per night\", \"per ride\"."
        },
        "is_free": {
          "type": "boolean",
          "description": "True only if the page says it is free (tips may still be expected)."
        }
      },
      "description": "Ticket price when `price_model` is `paid`."
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "history",
          "architecture",
          "food",
          "street_art",
          "culture",
          "nightlife",
          "ghosts_legends",
          "religion",
          "nature",
          "photography",
          "politics",
          "other"
        ],
        "description": "Theme."
      },
      "maxItems": 4,
      "description": "Themes."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40,
        "description": "Language in English."
      },
      "maxItems": 8,
      "description": "Languages offered."
    },
    "start_times": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5,
        "description": "A start time (24 h HH:MM).",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "maxItems": 6,
      "description": "Daily start times."
    },
    "days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ],
        "description": "Day."
      },
      "maxItems": 7,
      "description": "Days it runs."
    },
    "booking_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "Listing or booking URL.",
      "pattern": "^https?://[^\\s]+$"
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "description": "Average rating as shown.",
          "minimum": 0,
          "maximum": 100
        },
        "scale": {
          "type": "number",
          "description": "Top of the rating scale (5, 10 or 100).",
          "minimum": 1,
          "maximum": 100
        },
        "count": {
          "type": "integer",
          "description": "Number of reviews behind the rating.",
          "minimum": 0
        }
      },
      "description": "A rating shown on the page (never computed)."
    },
    "source_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "The page's own link for this item (official site, booking or detail page), copied verbatim from the page.",
      "pattern": "^https?://[^\\s]+$"
    },
    "as_of": {
      "type": "string",
      "maxLength": 10,
      "description": "The \"last updated\", \"valid from\" or publication date the page itself states for this information (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300,
        "description": "A verbatim quote from the page."
      },
      "maxItems": 3,
      "description": "Up to 3 short verbatim quotes from the page that support the most important facts."
    }
  },
  "required": [
    "name",
    "city",
    "country"
  ]
}
