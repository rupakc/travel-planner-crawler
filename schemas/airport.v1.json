{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rupakc/travel-planner-crawler/schemas/airport.v1.json",
  "title": "Airport",
  "description": "One record: one airport, with how to get from it to the city. Voyager use: flights origin/destination resolution, layover, getting_around airport transfers.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "iata": {
      "type": "string",
      "maxLength": 3,
      "description": "IATA code.",
      "pattern": "^[A-Z]{3}$"
    },
    "icao": {
      "type": "string",
      "maxLength": 4,
      "description": "ICAO code.",
      "pattern": "^[A-Z]{4}$"
    },
    "name": {
      "type": "string",
      "maxLength": 160,
      "description": "Airport name as written."
    },
    "city": {
      "type": "string",
      "maxLength": 120,
      "description": "City in English. Always paired with `country`."
    },
    "country": {
      "type": "string",
      "maxLength": 80,
      "description": "Country in English (e.g. \"Japan\"). Required whenever `city` is set."
    },
    "country_code": {
      "type": "string",
      "maxLength": 2,
      "description": "ISO 3166-1 alpha-2 country code of `country`.",
      "pattern": "^[A-Z]{2}$"
    },
    "lat": {
      "type": "number",
      "description": "Latitude in decimal degrees, only if the page states coordinates.",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "description": "Longitude in decimal degrees, only if the page states coordinates.",
      "minimum": -180,
      "maximum": 180
    },
    "terminals": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40,
        "description": "Terminal name."
      },
      "maxItems": 8,
      "description": "Terminals."
    },
    "city_transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "train",
              "metro",
              "bus",
              "shuttle",
              "taxi",
              "rideshare",
              "ferry",
              "other"
            ],
            "description": "Mode."
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "description": "Service name, e.g. \"Haruka Express\"."
          },
          "to": {
            "type": "string",
            "maxLength": 160,
            "description": "Destination in the city."
          },
          "duration_minutes": {
            "type": "integer",
            "description": "Typical journey time.",
            "minimum": 0,
            "maximum": 600
          },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 80,
                "description": "The price exactly as written on the page, e.g. \"€45.00\", \"from ¥1,500\", \"Free\"."
              },
              "amount": {
                "type": "number",
                "description": "The number in `text`, without currency symbols or thousands separators.",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "maxLength": 3,
                "description": "ISO 4217 code of the currency in `text`; never converted.",
                "pattern": "^[A-Z]{3}$"
              },
              "unit": {
                "type": "string",
                "maxLength": 40,
                "description": "What the price is for, e.g. \"per person\", \"per night\", \"per ride\"."
              },
              "is_free": {
                "type": "boolean",
                "description": "True only if the page says it is free (tips may still be expected)."
              }
            },
            "description": "Fare."
          },
          "hours": {
            "type": "string",
            "maxLength": 120,
            "description": "Operating hours."
          }
        },
        "required": [
          "mode"
        ]
      },
      "maxItems": 8,
      "description": "Ways to reach the city."
    },
    "phone": {
      "type": "string",
      "maxLength": 32,
      "description": "Airport information phone. As written on the page (digits, spaces, +, -, (, ), .).",
      "pattern": "^\\+?[0-9][0-9 ().\\-/]{1,30}$"
    },
    "website_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "Official airport website.",
      "pattern": "^https?://[^\\s]+$"
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60,
        "description": "Facility, e.g. \"free wifi\", \"24h pharmacy\"."
      },
      "maxItems": 10,
      "description": "Traveller facilities."
    },
    "source_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "The page's own link for this item (official site, booking or detail page), copied verbatim from the page.",
      "pattern": "^https?://[^\\s]+$"
    },
    "as_of": {
      "type": "string",
      "maxLength": 10,
      "description": "The \"last updated\", \"valid from\" or publication date the page itself states for this information (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300,
        "description": "A verbatim quote from the page."
      },
      "maxItems": 3,
      "description": "Up to 3 short verbatim quotes from the page that support the most important facts."
    }
  },
  "required": [
    "name",
    "city",
    "country"
  ]
}
