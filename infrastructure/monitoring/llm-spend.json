{
  "displayName": "voyager-crawler: LLM monthly spend over 80% of cap",
  "combiner": "OR",
  "enabled": true,
  "userLabels": {
    "app": "voyager-crawler"
  },
  "documentation": {
    "content": "LLM spend this month is over 80 % of the crawler's monthly cap (\u00a717.4). Hitting the daily cap is normal and is not alerted.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "month spend / cap > 0.8",
      "conditionThreshold": {
        "filter": "metric.type=\"custom.googleapis.com/crawler/llm_month_spend_ratio\" AND resource.type=\"gce_instance\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.8,
        "duration": "0s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MAX"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "severity": "ERROR"
}
