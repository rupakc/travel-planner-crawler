{
  "displayName": "voyager-crawler: parked keys over 25% of active keys",
  "combiner": "OR",
  "enabled": true,
  "userLabels": {
    "app": "voyager-crawler"
  },
  "documentation": {
    "content": "More than a quarter of the active politeness keys are parked (challenges, 401/403, repeated errors). Review with `vcrawl admin status`.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "parked / active keys > 0.25",
      "conditionThreshold": {
        "filter": "metric.type=\"custom.googleapis.com/crawler/parked_keys_ratio\" AND resource.type=\"gce_instance\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.25,
        "duration": "1800s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MAX"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "severity": "ERROR"
}
