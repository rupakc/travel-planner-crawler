{
  "displayName": "voyager-crawler: backup or WAL archive too old",
  "combiner": "OR",
  "enabled": true,
  "userLabels": {
    "app": "voyager-crawler"
  },
  "documentation": {
    "content": "The newest archived WAL segment is older than 2 h, or the newest base backup is older than 8 days (weekly full backups, Saturdays; wal-g \u2192 gs://voyager-crawler-ops/walg). Check `voyager-crawler-basebackup.service` and Postgres `archive_command` errors. The ages come from the maintenance role (Postgres `pg_stat_archiver`; the base-backup unit's `last_ok_at`); no age reported at all (archiving never succeeded, no base backup yet, maintenance down) alerts too.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "WAL archive age > 2 h",
      "conditionThreshold": {
        "filter": "metric.type=\"custom.googleapis.com/crawler/wal_archive_age_seconds\" AND resource.type=\"gce_instance\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 7200,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MAX"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "base backup age > 8 days",
      "conditionThreshold": {
        "filter": "metric.type=\"custom.googleapis.com/crawler/base_backup_age_seconds\" AND resource.type=\"gce_instance\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 691200,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MAX"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "WAL archive age not reported for 1 h",
      "conditionAbsent": {
        "filter": "metric.type=\"custom.googleapis.com/crawler/wal_archive_age_seconds\" AND resource.type=\"gce_instance\"",
        "duration": "3600s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "base backup age not reported for 24 h",
      "conditionAbsent": {
        "filter": "metric.type=\"custom.googleapis.com/crawler/base_backup_age_seconds\" AND resource.type=\"gce_instance\"",
        "duration": "84600s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "severity": "ERROR"
}
